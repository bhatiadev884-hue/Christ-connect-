{
  "version": 2,
  "builds": [
    {
      "src": "**/*.php",
      "use": "vercel-php"
    },
    {
      "src": "(.*).css",
      "use": "@vercel/static"
    },
    {
      "src": "(.*).js",
      "use": "@vercel/static"
    },
    {
      "src": "(.*).(png|jpg|jpeg|gif|svg|ico|pdf|docx)",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
